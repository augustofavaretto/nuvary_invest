# Servidor
PORT=3001
NODE_ENV=development

# Cache TTL (em segundos)
CACHE_TTL=300

# Finnhub (cotações e notícias de mercado)
FINNHUB_API_KEY=your_finnhub_key

# News API (notícias de negócios) — aceita até 2 chaves em rotação
NEWS_API_KEY_1=your_news_api_key_1
NEWS_API_KEY_2=your_news_api_key_2

# OpenAI (assistente IA)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o

# Brapi (ações/FIIs da B3)
BRAPI_API_TOKEN=your_brapi_token

# Mercado Pago (plano Premium)
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret
MERCADOPAGO_SUCCESS_URL=https://your-app.vercel.app/premium/sucesso
MERCADOPAGO_FAILURE_URL=https://your-app.vercel.app/premium/erro
MERCADOPAGO_PENDING_URL=https://your-app.vercel.app/premium/pendente

# Supabase (service-role — usado pelo webhook do MP)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
